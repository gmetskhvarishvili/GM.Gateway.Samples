{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "orders": {
        "ClusterId": "backend",
        "Match": { "Path": "/orders/{**catch-all}" },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "products": {
        "ClusterId": "backend",
        "Match": { "Path": "/products/{**catch-all}" },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "open": {
        "ClusterId": "backend",
        "Match": { "Path": "/open/{**catch-all}" }
      }
    },
    "Clusters": {
      "backend": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5100/" }
        }
      }
    }
  },

  "RateLimiting": {
    "Policies": {
      "api": { "Algorithm": "FixedWindow", "PermitLimit": 5, "Window": "00:01:00" }
    }
  },

  "//Redis": "Uncomment ConnectionString (or set env Redis__ConnectionString) to enforce limits across gateway instances via the atomic Redis store.",
  "Redis": {
    "//ConnectionString": "localhost:6379"
  }
}
